<!-- Avatar Upload -->
<div class="mb-8 text-center">
    <div class="relative inline-block">
        <div class="w-40 h-40 rounded-full bg-gray-200 border-4 border-white shadow-lg overflow-hidden">
            <%= image_tag "avatar_default.png", alt: "Avatar", class: "w-full h-full object-cover avatar-action", id: "avatarPreview" %>
        </div>
        <%= form.label :avatar, class: "absolute bottom-1 right-1 bg-indigo-600 text-white p-2 rounded-full shadow-lg cursor-pointer avatar-upload" do %>
            <span class="avatar-action">
                <%= render 'common/icon_cam' %>
            </span>
            <%= form.file_field :avatar, class: "hidden", accept: "image/*", id: "avatarInput"  %>
        <% end %>
    </div>
    <% if @form.errors[:avatar].any? %>
        <p class="text-red-500 text-sm mt-2">
          <%= @form.errors[:avatar].join(", ") %>
        </p>
    <% else %>
        <p class="text-gray-500 text-sm mt-2">Click on the camera icon to change your profile picture</p>
    <% end %>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Name Field -->
    <div class="md:col-span-2">
        <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-2" do %>
            Full name<span class="text-red-500">*</span>
        <% end %>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <%= form.text_field :name, autofocus: true,  placeholder: "Enter your full name",
                class: [
                    "pl-10 w-full px-4 py-3 border rounded-lg focus:outline-none input-focus transition-all",
                    (@form.errors[:name].any? ? "border-red-500" : "border-gray-300")
                ].join(" ") %>
        </div>
        <% if @form.errors[:name].any? %>
            <p class="text-red-500 text-sm mt-1">
            <%= @form.errors[:name].join(", ") %>
            </p>
        <% end %>
    </div>

    <!-- Email Field -->
    <div class="md:col-span-2">
        <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-2" do %>
            Email<span class="text-red-500">*</span>
        <% end %>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
            </div>
            <%= form.email_field :email, autofocus: true, autocomplete: "email",
                class: [
                    "pl-10 w-full px-4 py-3 border rounded-lg focus:outline-none input-focus transition-all",
                    (@form.errors[:email].any? ? "border-red-500" : "border-gray-300")
                ].join(" "),
                placeholder: "Enter email address" %>
        </div>
        <% if @form.errors[:email].any? %>
            <p class="text-red-500 text-sm mt-1">
            <%= @form.errors[:email].join(", ") %>
            </p>
        <% end %>
    </div>

    <!-- Phone Number Field -->
    <div>
        <%= form.label :phone_number, "Phone number", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
            </div>
            <%= form.text_field :phone_number, autofocus: true,
                class: [
                    "pl-10 w-full px-4 py-3 border rounded-lg focus:outline-none input-focus transition-all",
                    (@form.errors[:phone_number].any? ? "border-red-500" : "border-gray-300")
                ].join(" "),
                placeholder: "0123456789" %>
        </div>
        
        <% if @form.errors[:phone_number].any? %>
            <p class="text-red-500 text-sm mt-1">
            <%= @form.errors[:phone_number].join(", ") %>
            </p>
        <% else %>
            <p class="text-gray-500 text-sm mt-1">Maximum 13 characters</p>
        <% end %>
    </div>

    <% if current_user.role==@roles[:superAdmin] %>
        <!-- Team Field -->
        <div>
            <%= form.label :team_id, class: "block text-sm font-medium text-gray-700 mb-2" do %>
                Team <span class="text-red-500">*</span>
            <% end %>

            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>
                <%= form.select :team_id, options_for_select(@team_options), { prompt: "Choose team" },
                    class: [
                    "pl-10 w-full px-4 py-3 border rounded-lg focus:outline-none input-focus transition-all appearance-none bg-white",
                    (@form.errors[:team_id].any? ? "border-red-500" : "border-gray-300")
                ].join(" ")%>
                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </div>
            </div>

            <% if @form.errors[:team_id].any? %>
                <p class="text-red-500 text-sm mt-1">
                    <%= @form.errors[:team_id].join(", ") %>
                </p>
            <% end %>
        </div>

        <!-- Role Field -->
        <div>
            <%= form.label :role, class: "block text-sm font-medium text-gray-700 mb-2" do %>
                Team <span class="text-red-500">*</span>
            <% end %>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" />
                    </svg>
                </div>
                <%= form.select :role, options_for_select(@role_value_options), { prompt: "Choose role" }, 
                    class: [
                    "pl-10 w-full px-4 py-3 border rounded-lg focus:outline-none input-focus transition-all appearance-none bg-white",
                        (@form.errors[:role].any? ? "border-red-500" : "border-gray-300")
                    ].join(" ")%>
                <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </div>
            </div>
            <% if @form.errors[:role].any? %>
                <p class="text-red-500 text-sm mt-1">
                    <%= @form.errors[:role].join(", ") %>
                </p>
            <% end %>
        </div>
        <% end %>

            <!-- Password Field -->
            <div>
                <%= form.label :password, class: "block text-sm font-medium text-gray-700 mb-2" do %>
                    Password <span class="text-red-500">*</span>
                <% end %>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                        <%= form.password_field :password, autocomplete: "current-password", 
                            class: [
                                "pl-10 w-full px-4 py-3 border rounded-lg focus:outline-none input-focus transition-all",
                                (@form.errors[:password].any? ? "border-red-500" : "border-gray-300")
                            ].join(" "),
                            autofocus: true,
                            id: "password",
                            placeholder: "Enter password" %>

                    <button type="button" class="absolute inset-y-0 right-0 pr-3 flex items-center togglePassword"
                        onclick="togglePassword('password')">
                        <svg id="passwordEye" class="w-5 h-5 text-gray-400 hover:text-gray-600" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>
                </div>

                <% if @form.errors[:password].any? %>
                    <p class="text-red-500 text-sm mt-1">
                    <%= @form.errors[:password].join(", ") %>
                    </p>
                <% end %>
            </div>

            <!-- Password Confirmation Field -->
            <div>
                <%= form.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-2" do %>
                    Confirm password <span class="text-red-500">*</span>
                <% end %>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                    </div>
                    <%= form.password_field :password_confirmation, 
                            class: [
                                "pl-10 w-full px-4 py-3 border rounded-lg focus:outline-none input-focus transition-all",
                                (@form.errors[:password_confirmation].any? ? "border-red-500" : "border-gray-300")
                            ].join(" "),
                            autofocus: true,
                            id: "password_confirmation",
                            placeholder: "Confirm password" %>
                    <button type="button" class="absolute inset-y-0 right-0 pr-3 flex items-center"
                        onclick="togglePassword('password_confirmation')">
                        <svg id="passwordConfirmationEye" class="w-5 h-5 text-gray-400 hover:text-gray-600" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>
                </div>
                <p class="text-red-500 text-sm mt-1 hidden" id="passwordError">Mật khẩu không khớp</p>
            </div>
</div>