<% content_for :title, "Create team" %>
<% content_for :page_title, "Create team" %>

<div class="form-card rounded-2xl shadow-2xl p-8">
    <%= form_for(@form, url: teams_new_path, method: :post, html: { id: "teamForm" }) do |f| %>
        <%= render 'teams/includes/form' , team: "", form: f %>
        <!-- Form Actions -->
        <div class="flex flex-col sm:flex-row gap-4 justify-end mt-8 pt-6 border-t border-gray-200">
            <%= link_to teams_path, 
                class: "px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-all flex items-center justify-center" do%>
                <%= render 'common/icon_back' %>
                Back to list
            <% end %>
            <button type="submit"
                class="px-6 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-lg hover:from-indigo-700 hover:to-purple-700 transition-all shadow-lg flex items-center justify-center">
                <%= render 'common/icon_save' %>
                Save information
            </button>
        </div>
    <% end %>
</div>