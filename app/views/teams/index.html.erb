<% content_for :title, "List teams" %>
<% content_for :page_title, "List teams" %>
<% content_for :modal_confirm_method, :delete%>
<% content_for :modal_confirm_text, "Are you sure you want to delete this team?" %>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4 space-y-2 sm:space-y-0 sm:space-x-2">
  <%= link_to "Create New", new_team_path, class: "px-4 py-2 bg-green-600 text-white rounded-sm hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 shadow-md" %>

  <form action="<%= teams_path %>" method="get" class="flex flex-1 max-w-md">
    <input 
      type="text" 
      name="search" 
      placeholder="Search teams..." 
      class="flex-1 px-4 py-2 border border-gray-300 rounded-l-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-sm"
      value="<%= params[:search] %>"
    >
    <button 
      type="submit" 
      class="px-4 py-2 bg-indigo-600 text-white rounded-r-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-md"
    >
      Search
    </button>
  </form>
</div>


<div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Name
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider text-center">
                    Total Members
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider text-center">
                    Created At
                </th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Action
                </th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            <% @teams.each do |team| %>
                <tr class="hover:bg-gray-50 transition">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900"><%= team.name %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-center">
                        <div class="text-sm text-gray-900"><%= team.users.count %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-center">
                        <div class="text-sm text-gray-900"><%= team.created_at.strftime("%Y/%m/%d, %I:%M %p") %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium flex space-x-3">
                        <%= link_to edit_team_path(team), method: :get, 
                            class: 'inline-flex items-center text-indigo-600 hover:text-indigo-900 transition-colors' do %>
                            <%= render 'common/icon_edit' %>
                        <% end %>
                        <button class="text-red-600 hover:text-red-900 transition-colors delete-action" command="show-modal" commandfor="dialog" data-path="<%= team_path(team) %>">
                            <%= render 'common/icon_delete'%>
                        </button>
                    </td>

                </tr>
            <% end %>
            <% if @teams.empty? %>
                <tr>
                    <td colspan="4" class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-500">
                    No data found.
                    </td>
                </tr>
            <% end %>
        </tbody>
    </table>
</div>
<div class="mt-4 text-center">
  <%= paginate @teams %>
</div>