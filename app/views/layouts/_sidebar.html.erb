<aside class="w-64 bg-white shadow-md">
  <div class="flex items-center justify-center h-16 bg-blue-600 text-white">
    <h1 class="text-xl font-bold">Staff Manager</h1>
  </div>
  
  <nav class="mt-6">
    <div class="px-4 py-2 text-xs font-semibold text-gray-400 uppercase">MAIN</div>
    <% if is_supper_admin %>
      <%= link_to root_path, class: "flex items-center px-6 py-3 text-gray-600 hover:bg-blue-50 hover:text-blue-600 #{'bg-blue-50 text-blue-600 border-r-2 border-blue-600' if current_page?(root_path)}" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span class="mx-3">Dashboard</span>
      <% end %>
    <% end %>

    <%= link_to users_path, class: "flex items-center px-6 py-3 text-gray-600 hover:bg-blue-50 hover:text-blue-600 #{'bg-blue-50 text-blue-600 border-r-2 border-blue-600' if controller_name == 'users'}" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
      </svg>
      <span class="mx-3">Users</span>
    <% end %>

    <% if is_supper_admin %>
      <%= link_to teams_path, class: "flex items-center px-6 py-3 text-gray-600 hover:bg-blue-50 hover:text-blue-600 #{'bg-blue-50 text-blue-600 border-r-2 border-blue-600' if controller_name == 'teams'}" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
            d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87M15 11a4 4 0 10-8 0 4 4 0 008 0zm6 8v-2a4 4 0 00-3-3.87M3 16.13A4 4 0 016 12h12a4 4 0 013 4v2">
          </path>
        </svg>
        <span class="mx-3">Teams</span>
      <% end %>
    <% end %>

    <div class="px-4 py-2 mt-4 text-xs font-semibold text-gray-400 uppercase">SYSTEM</div>
    
    <button class="w-full flex items-center px-6 py-3 text-gray-600 hover:bg-blue-50 hover:text-blue-600"
      command="show-modal" commandfor="<%= Rails.configuration.const['id_modal_confirm_logout'] %>">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1"/>
        </svg>
        <span class="mx-3">Logout</span>
    </button>
  </nav>
</aside>