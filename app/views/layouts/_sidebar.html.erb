<ul class="flex flex-col bg-[#4e73df] bg-cover text-white w-56 min-h-screen sidebar transition-all" id="accordionSidebar">
  <!-- Sidebar - Brand -->
  <a class="flex items-center justify-center p-4 hover:bg-blue-700 transition-colors" href="<%= is_supper_admin ? root_path : users_path %>">
    <img src="/logo.png" alt="Staff Manager Logo" class="w-9 h-9 mr-2">
    <div class="text-lg font-semibold" id="title-sidebar" data-title="Staff Manager">Staff Manager</div>
  </a>

  <!-- Divider -->
  <hr class="border-t border-[#ffffff26] mx-4 my-2">
  
  <!-- Heading -->
  <div class="sidebar-heading px-4 py-2 text-xs uppercase tracking-wider text-gray-300">
    MAIN
  </div>

  <% if is_supper_admin %>
    <li class="<%= 'bg-blue-800' if current_page?(root_path) %>">
      <%= link_to root_path, class: "collapse-group flex items-center px-4 py-3 hover:bg-blue-700 transition-colors text-sm" do %>
        <i class="fas fa-fw fa-tachometer-alt w-6 text-center"></i>
        <span class="ml-2">Dashboard</span>
      <% end %>
    </li>
  <% end %>

  <li class="<%= 'bg-blue-700' if controller_name == 'users' %> relative">
    <a href="javascript:" class="flex items-center justify-between px-4 py-3 hover:bg-blue-700 transition-colors cursor-pointer text-sm" 
       onclick="toggleCollapse(event, 'collapseUsers')">
      <div class="collapse-group flex items-center">
        <i class="fas fa-fw fa-user w-6 text-center"></i>
        <span class="ml-2">Users</span>
      </div>
      <i class="fas fa-chevron-down text-xs transition-transform collapse-icon" id="collapseUsersIcon"></i>
    </a>
    <div id="collapseUsers" class="popup-menu hidden bg-blue-800 py-2 rounded mx-2 mt-1 mb-2 p-2">
      <%= link_to "List", users_path, class: "block px-4 py-2 text-sm hover:bg-blue-600 rounded transition-colors" %>
      <%= link_to "Create new", new_user_path, class: "block px-4 py-2 text-sm hover:bg-blue-600 rounded transition-colors" %>
    </div>
  </li>

  <% if is_supper_admin %>
    <li class="<%= 'bg-blue-700' if controller_name == 'teams' %> relative">
      <a href="javascript:" class="flex items-center justify-between px-4 py-3 hover:bg-blue-700 transition-colors cursor-pointer text-sm" 
         onclick="toggleCollapse(event, 'collapseTeams')">
        <div class="collapse-group flex items-center">
          <i class="fas fa-fw fa-users w-6 text-center"></i>
          <span class="ml-2">Teams</span>
        </div>
        <i class="fas fa-chevron-down text-xs transition-transform collapse-icon" id="collapseTeamsIcon"></i>
      </a>
      <div id="collapseTeams" class="popup-menu hidden bg-blue-800 py-2 rounded mx-2 mt-1 mb-2 p-2">
        <%= link_to "List", teams_path, class: "block px-4 py-2 text-sm hover:bg-blue-600 rounded transition-colors" %>
        <%= link_to "Create new", new_team_path, class: "block px-4 py-2 text-sm hover:bg-blue-600 rounded transition-colors" %>
      </div>
    </li>
  <% end %>

  <!-- Divider -->
  <hr class="border-t border-[#ffffff26] mx-4 my-2">

  <!-- Heading -->
  <div class="sidebar-heading px-4 py-2 text-xs uppercase tracking-wider text-gray-300">
    SYSTEM
  </div>

  <!-- Nav Item - Logout -->
  <li class="flex justify-center">
    <button class="w-full collapse-group flex items-center px-4 py-3 hover:bg-blue-700 transition-colors text-left text-sm"
      command="show-modal" commandfor="<%= Rails.configuration.const['id_modal_confirm_logout'] %>">
        <i class="fas fa-fw fa-sign-out-alt w-6 text-center"></i>
        <span class="ml-2">Logout</span>
    </button>
  </li>

  <!-- Divider -->
  <hr class="border-t border-[#ffffff26] mx-4 my-2">

  <!-- Sidebar Toggler (Sidebar) -->
  <div class="w-full py-4 flex justify-center">
    <button class="rounded-full bg-[#ffffff33] w-10 h-10 flex items-center justify-center hover:bg-[#ffffff40] transition-colors" id="sidebarToggle">
    </button>
  </div>
</ul>